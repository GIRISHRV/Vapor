{
  "database": {
    "rules": "database.rules.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "vapor-engine",
          "appId": "1:44563271076:android:f90104f5e9828de3c74531",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "vapor-engine",
          "configurations": {
            "android": "1:44563271076:android:f90104f5e9828de3c74531",
            "ios": "1:44563271076:ios:cb0ccf127f211b9ac74531",
            "macos": "1:44563271076:ios:cb0ccf127f211b9ac74531",
            "web": "1:44563271076:web:51e64864bdeb0ad9c74531",
            "windows": "1:44563271076:web:73e336dbc5ac3340c74531"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html|json|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
